{
  "name": "@ig/api",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "jest --runInBand",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "test:db": "jest --config jest.db.config.cjs --runInBand",
    "build:lambda": "esbuild src/lambda/http.ts src/lambda/sqs.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist-lambda --entry-names='[name]' --external:@nestjs/microservices --external:@nestjs/websockets --external:class-validator --external:class-transformer",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1117.0",
    "@aws-sdk/client-sqs": "^3.1117.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "hash-wasm": "^4.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "7.2.1",
    "esbuild": "^0.28.2",
    "jest": "30.5.2",
    "prisma": "^7.10.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  }
}
